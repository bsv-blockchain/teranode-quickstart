# Alert System settings for testnet, read only by the alert service
# (compose/docker-teranode.yml), ahead of .env.
#
# Teranode ships the mainnet genesis keys and protocol ID for every network;
# only the topic (bitcoin_alert_system_testnet) is derived from the network.
# With mainnet values a testnet node can neither sync alert history from
# testnet peers nor verify testnet alerts. These are the testnet values from
# https://github.com/bsv-blockchain/go-alert-system/blob/v0.1.17/app/config/envs/testnet.json
# (the library Teranode embeds); the protocol ID matches
# https://docs.bsvblockchain.org/network-topology/nodes/sv-node/alert-system
#
# Format: pipe-separated, no spaces, no quotes (Docker Compose reads this
# file; nothing sources it in bash).
alert_protocol_id=/bitcoin-testnet/alert-system/0.0.1
alert_genesis_keys=0203aa8ca16b6b247b109b65e9d7a0f3a23ccae8f093f792e63bf5ce2567f572bc|0289d3a1c6dacd0ee3de7e5a960d8d226ffbdb82b3af41b4c6a01b0230cc6e0dce|0396d8808641463b41fe31b11717294e2e14941454ba6b27967ed571b9848ae768|02aaf9583bd5aa8e5993666e11785ff3b1b0a97694003b22cbd8a2b7150ff27736|02dfb76a88100c2b6cd7ad9c051bc9ef9daf74c9fa13a99cb870865a046a9772f1
